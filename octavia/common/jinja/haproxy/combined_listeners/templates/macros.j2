{% macro http_header_persistence_response(pool) %}
    {% set persistence = pool.session_persistence %}
    {% for member in pool.members if member.enabled and member.weight > 0 %}
    use-server {{ member.id }} if { var(txn.octavia_header_member) -m str {{ member.header_persistence_token }} } { srv_is_up({{ member.id }}) }
    {% endfor %}
    {# Capture only upstream responses and use the server which actually
       responded, including any fallback selected by HAProxy. #}
    http-response set-var(txn.octavia_header_served_by) srv_name
    {% for member in pool.members %}
    {% set served = '{ var(txn.octavia_header_served_by) -m str ' ~ member.id ~ ' }' %}
    {% set same = '{ var(txn.octavia_header_member) -m str ' ~ member.header_persistence_token ~ ' }' %}
    http-after-response set-var(txn.octavia_header_out) var(txn.octavia_header_in) if {{ served }} {{ same }}
    http-after-response set-var-fmt(txn.octavia_header_issue) "v1.{{ member.header_persistence_token }}.%[date(0,us)]" if {{ served }} !{{ same }}
    {% endfor %}
    http-after-response set-var(txn.octavia_header_signature) var(txn.octavia_header_issue),hmac(sha256,txn.octavia_header_signing_key),ub64enc if { var(txn.octavia_header_issue) -m found }
    http-after-response set-var-fmt(txn.octavia_header_out) "%[var(txn.octavia_header_issue)].%[var(txn.octavia_header_signature)]" if { var(txn.octavia_header_signature) -m found }
    http-after-response add-header Cache-Control private if { var(txn.octavia_header_out) -m found }
    http-after-response set-header {{ persistence.header_config_name|safe }} "%[var(txn.octavia_header_out)]" if { var(txn.octavia_header_out) -m found }
{% endmacro %}


{% macro http_cookie_path(cookie) %}
    {% set name = (cookie.cookie_name or 'SRV')|replace('.', '[.]') %}
    {% set replacement = cookie.cookie_path_replacement %}
    {# The native and signed cookies have a single default Path at this stage.
