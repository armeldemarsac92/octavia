{% macro select_scoped_http_cookie(name, value_pattern) %}
    {% set escaped_name = name|replace('.', '[.]') %}
    {% set pair = escaped_name ~ '[[:blank:]]*=[[:blank:]]*(' ~ value_pattern ~ ')[[:blank:]]*' %}
    acl octavia_cookie_repeated req.cook_cnt({{ name }}) gt 1
    acl octavia_cookie_scoped var(txn.octavia_cookie_headers) -m reg '(^|;)[[:blank:]]*{{ pair }}(;|$)'
    acl octavia_cookie_scope_repeated var(txn.octavia_cookie_headers) -m reg '(^|;)[[:blank:]]*{{ pair }};([^;]*;)*[[:blank:]]*{{ pair }}(;|$)'
    http-request set-var(txn.octavia_cookie_headers) req.fhdr(cookie) if octavia_cookie_repeated { req.fhdr_cnt(cookie) eq 1 }
    {# Join repeated Cookie fields before selecting the single cookie for this
       path. The literal escapes are parsed by HAProxy before the regex. #}
    http-request set-var(txn.octavia_cookie_headers) {{ joined_request_header('cookie', '; ') }} if octavia_cookie_repeated { req.fhdr_cnt(cookie) gt 1 }
    http-request set-var(txn.octavia_cookie) 'var(txn.octavia_cookie_headers),regsub("^([^;]*;)*[[:blank:]]*{{ pair }}(;.*|$)$","\2")' if octavia_cookie_scoped !octavia_cookie_scope_repeated
{% endmacro %}


{% macro absolute_http_cookie(pool) %}
    {% set cookie = pool.session_persistence %}
    {% set name = cookie.cookie_name %}
    {% set escaped_name = name|replace('.', '[.]') %}
    {% if cookie.cookie_max_age is defined %}
        {% set attributes = 'Path=/; Max-Age=' ~ cookie.cookie_max_age %}
    {% else %}
        {% set attributes = 'path=/' %}
    {% endif %}
    {% set value_pattern = 'v1[.]' ~ cookie.get('cookie_path_token', '') ~ '[0-9a-f]{32}[.][1-9][0-9]{0,17}[.][A-Za-z0-9_-]{43}' %}
    acl octavia_cookie_unique req.cook_cnt({{ name }}) eq 1
    acl octavia_cookie_format var(txn.octavia_cookie) -m reg '^{{ value_pattern }}$'
    acl octavia_cookie_age_valid var(txn.octavia_cookie_age) -m int ge 0
    acl octavia_cookie_age_below_limit var(txn.octavia_cookie_age) -m int lt {{ cookie.absolute_timeout_us }}
    acl octavia_cookie_authenticated var(txn.octavia_cookie_payload),hmac(sha256,txn.octavia_cookie_signing_key),ub64enc,secure_memcmp(txn.octavia_cookie_tag) -m bool
    http-request set-var(txn.octavia_cookie_signing_key) str({{ cookie.signing_key }})
    http-request set-var(txn.octavia_cookie) req.cook({{ name }}) if octavia_cookie_unique
    {% if cookie.cookie_path_token is defined %}
{{ select_scoped_http_cookie(name, value_pattern) -}}
    {% endif %}
    http-request set-var(txn.octavia_cookie_issued) var(txn.octavia_cookie),word(3,.) if octavia_cookie_format
    http-request set-var(txn.octavia_cookie_age) date(0,us),sub(txn.octavia_cookie_issued) if octavia_cookie_format
    http-request set-var(txn.octavia_cookie_tag) var(txn.octavia_cookie),word(4,.) if octavia_cookie_age_valid octavia_cookie_age_below_limit
    http-request set-var-fmt(txn.octavia_cookie_payload) "v1.%[var(txn.octavia_cookie),word(2,.)].%[var(txn.octavia_cookie_issued)]" if octavia_cookie_age_valid octavia_cookie_age_below_limit
    http-request set-var(txn.octavia_cookie_member) var(txn.octavia_cookie),word(2,.) if octavia_cookie_age_valid octavia_cookie_age_below_limit octavia_cookie_authenticated
    http-response set-var(txn.octavia_cookie_served_by) srv_name
    acl octavia_cookie_marker res.fhdr(Set-Cookie) -m beg {{ name }}=
    {# Issue from the authenticated request and the actual responding member.
       The native cookie stage removes the reserved name, then may insert a
       removal marker. Rewrite that marker if present. #}
    {% for member in pool.members %}
    use-server {{ member.id }} if { var(txn.octavia_cookie_member) -m str {{ member.persistence_cookie }} }
    http-after-response set-var-fmt(txn.octavia_cookie_issue) "v1.{{ member.persistence_cookie }}.%[date(0,us)]" if { var(txn.octavia_cookie_served_by) -m str {{ member.id }} } !{ var(txn.octavia_cookie_member) -m str {{ member.persistence_cookie }} }
    {% endfor %}
    http-after-response set-var(txn.octavia_cookie_signature) var(txn.octavia_cookie_issue),hmac(sha256,txn.octavia_cookie_signing_key),ub64enc if { var(txn.octavia_cookie_issue) -m found }
    http-after-response set-var-fmt(txn.octavia_cookie_out) "%[var(txn.octavia_cookie_issue)].%[var(txn.octavia_cookie_signature)]" if { var(txn.octavia_cookie_signature) -m found }
    http-after-response add-header Cache-Control private if !octavia_cookie_marker { var(txn.octavia_cookie_out) -m found }
    http-after-response add-header Set-Cookie "{{ name }}=%[var(txn.octavia_cookie_out)]; {{ attributes }}" if !octavia_cookie_marker { var(txn.octavia_cookie_out) -m found }
    {% if cookie.cookie_max_age is defined %}
    {# Ignore a native removal marker if the request cookie still applies.
