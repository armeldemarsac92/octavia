          and pool.health_monitor.http_version in (1.0, 1.1) %}
        {% set h2c_opt = h2c_opt + " check-proto h1" %}
    {% endif %}
    {{ "server %s %s:%d weight %s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s"|e|format(
        member.id, member.address, member.protocol_port, member.weight,
