    http-after-response replace-header Set-Cookie '^{{ escaped_name }}=.*$' "%[var(txn.octavia_cookie_out)]" if octavia_cookie_marker !{ var(txn.octavia_cookie_issue) -m found } { var(txn.octavia_cookie_member) -m found }
    {% else %}
    http-after-response set-var(txn.octavia_cookie_out) var(txn.octavia_cookie) if octavia_cookie_marker !{ var(txn.octavia_cookie_issue) -m found } { var(txn.octavia_cookie_member) -m found }
    {% endif %}
    http-after-response replace-header Set-Cookie '^{{ escaped_name }}=.*$' "{{ name }}=%[var(txn.octavia_cookie_out)]; {{ attributes }}" if octavia_cookie_marker { var(txn.octavia_cookie_out) -m found }
