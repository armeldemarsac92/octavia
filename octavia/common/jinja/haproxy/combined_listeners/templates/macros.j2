{% macro peers_macro(constants, loadbalancer) %}
    {% if loadbalancer.topology == constants.TOPOLOGY_ACTIVE_STANDBY %}
peers {{ "%s_peers"|format(loadbalancer.id.replace("-", ""))|trim() }}
        {% for amp in loadbalancer.amphorae if (
            amp.status == constants.AMPHORA_ALLOCATED) %}
            {# HAProxy has peer name limitations, thus the hash filter #}
    peer {{ amp.id|hash_amp_id|replace('=', '') }} {{
    amp.vrrp_ip }}:{{ constants.HAPROXY_BASE_PEER_PORT }}
        {% endfor %}
    {% endif %}
{% endmacro %}


{% macro bind_macro(constants, lib_consts, listener, lb_vip_address, local_socket=None) %}
    {% if listener.crt_list_filename is defined %}
        {% set def_crt_opt = ("ssl crt-list %s"|format(
            listener.crt_list_filename)|trim()) %}
    {% else %}
        {% set def_crt_opt = "" %}
    {% endif %}
    {% if listener.client_ca_tls_path and listener.client_auth %}
        {% set client_ca_opt = " ca-file %s verify %s"|format(listener.client_ca_tls_path, listener.client_auth) %}
        {% if listener.client_auth_insecure_fallback %}
            {% set client_ca_opt = client_ca_opt + " ca-ignore-err all crt-ignore-err all" %}
        {% endif %}
    {% else %}
        {% set client_ca_opt = "" %}
    {% endif %}
    {% if listener.client_crl_path and listener.client_ca_tls_path %}
        {% set ca_crl_opt = " crl-file %s"|format(listener.client_crl_path) %}
    {% else %}
        {% set ca_crl_opt = "" %}
    {% endif %}
    {% if listener.tls_ciphers is defined and listener.tls_ciphers %}
        {% set ciphers_opt = " ciphers %s"|format(listener.tls_ciphers) %}
    {% else %}
        {% set ciphers_opt = "" %}
    {% endif %}
    {% if listener.tlsv1_3_ciphers is defined and listener.tlsv1_3_ciphers %}
        {% set ciphersuites_opt = " ciphersuites %s"|format(listener.tlsv1_3_ciphers) %}
    {% else %}
        {% set ciphersuites_opt = "" %}
    {% endif %}
    {% set tls_versions_opt = "" %}
    {% if listener.tls_versions is defined %}
        {% if lib_consts.SSL_VERSION_3 not in listener.tls_versions %}
            {% set tls_versions_opt = tls_versions_opt + " no-sslv3" %}
        {% endif %}
        {% if lib_consts.TLS_VERSION_1 not in listener.tls_versions %}
            {% set tls_versions_opt = tls_versions_opt + " no-tlsv10" %}
        {% endif %}
        {% if lib_consts.TLS_VERSION_1_1 not in listener.tls_versions %}
            {% set tls_versions_opt = tls_versions_opt + " no-tlsv11" %}
        {% endif %}
        {% if lib_consts.TLS_VERSION_1_2 not in listener.tls_versions %}
            {% set tls_versions_opt = tls_versions_opt + " no-tlsv12" %}
        {% endif %}
        {% if lib_consts.TLS_VERSION_1_3 not in listener.tls_versions %}
            {% set tls_versions_opt = tls_versions_opt + " no-tlsv13" %}
        {% endif %}
    {% endif %}
    {% if listener.alpn_protocols is defined %}
        {% set alpn_opt = " alpn %s"|format(listener.alpn_protocols) %}
    {% else %}
        {% set alpn_opt = "" %}
    {% endif %}

bind {% if local_socket %}{{ local_socket }} accept-proxy{% else %}{{ lb_vip_address }}:{{ listener.protocol_port }}{% endif %} {{
"%s%s%s%s%s%s%s"|format(def_crt_opt, client_ca_opt, ca_crl_opt, ciphers_opt, ciphersuites_opt, tls_versions_opt, alpn_opt)|trim() }}
{% endmacro %}


{% macro l7rule_compare_type_macro(constants, ctype, rtype=None) %}
    {% if ctype == constants.L7RULE_COMPARE_TYPE_REGEX %}
        {{- "-m reg" -}}
    {% elif ctype == constants.L7RULE_COMPARE_TYPE_STARTS_WITH %}
        {{- "-m beg" -}}
    {% elif ctype == constants.L7RULE_COMPARE_TYPE_ENDS_WITH %}
        {{- "-m end" -}}
    {% elif ctype == constants.L7RULE_COMPARE_TYPE_CONTAINS %}
        {{- "-m sub" -}}
    {% elif ctype == constants.L7RULE_COMPARE_TYPE_EQUAL_TO %}
        {# Specific handling for FILE_TYPE with EQUAL_TO, "path_end -m str"
        # doesn't work with haproxy, "path_end" is enough for this type of
        # comparison
        # https://github.com/haproxy/haproxy/issues/2567
        #}
        {% if rtype != constants.L7RULE_TYPE_FILE_TYPE %}
            {{- "-m str" -}}
        {% endif %}
    {% endif %}
{% endmacro %}


{% macro l7rule_macro(constants, l7rule, listener, raw_tls=False) %}
    {% if l7rule.type == constants.L7RULE_TYPE_TLS_SNI %}
        {% set sni_fetch = 'ssl_fc_sni' if listener.tcp_tls_termination and not raw_tls else 'req.ssl_sni' %}
        {% if l7rule.compare_type == constants.L7RULE_COMPARE_TYPE_ENDS_WITH %}
        acl {{ l7rule.id }} {{ sni_fetch }} -i -m end {{ l7rule.value[1:] }}
        {% else %}
        acl {{ l7rule.id }} {{ sni_fetch }} -i -m str {{ l7rule.value }}
        {% endif %}
    {% elif l7rule.type == constants.L7RULE_TYPE_HOST_NAME %}
        acl {{ l7rule.id }} req.hdr(host) -i {{ l7rule_compare_type_macro(
            constants, l7rule.compare_type) }} {{ l7rule.value }}
    {% elif l7rule.type == constants.L7RULE_TYPE_PATH %}
        acl {{ l7rule.id }} path {{ l7rule_compare_type_macro(
            constants, l7rule.compare_type) }} {{ l7rule.value }}
    {% elif l7rule.type == constants.L7RULE_TYPE_FILE_TYPE %}
        acl {{ l7rule.id }} path_end {{ l7rule_compare_type_macro(
            constants, l7rule.compare_type, l7rule.type) }} {{ l7rule.value }}
    {% elif l7rule.type == constants.L7RULE_TYPE_HTTP_METHOD %}
        acl {{ l7rule.id }} method {{ l7rule.value }}
    {% elif l7rule.type == constants.L7RULE_TYPE_HTTP_HEADER_EXACT %}
        acl {{ l7rule.id }} req.fhdr({{ l7rule.key|safe }}) -m bin {{ l7rule.value }}
    {% elif l7rule.type == constants.L7RULE_TYPE_HTTP_QUERY_PARAM_EXACT %}
        acl {{ l7rule.id }} {{ l7rule.key|safe }} -m bin {{ l7rule.value }}
    {% elif l7rule.type == constants.L7RULE_TYPE_GRPC_CONTENT_TYPE %}
        acl {{ l7rule.id }}_single req.fhdr_cnt(content-type) eq 1
        acl {{ l7rule.id }} req.fhdr(content-type) -m reg -i {{ l7rule.value|safe }}
    {% elif l7rule.type == constants.L7RULE_TYPE_HEADER %}
        acl {{ l7rule.id }} req.hdr({{ l7rule.key }}) {{
            l7rule_compare_type_macro(
            constants, l7rule.compare_type) }} {{ l7rule.value }}
    {% elif l7rule.type == constants.L7RULE_TYPE_COOKIE %}
        acl {{ l7rule.id }} req.cook({{ l7rule.key }}) {{
            l7rule_compare_type_macro(
            constants, l7rule.compare_type) }} {{ l7rule.value }}
    {% elif l7rule.type == constants.L7RULE_TYPE_SSL_CONN_HAS_CERT %}
        acl {{ l7rule.id }} ssl_c_used
    {% elif l7rule.type == constants.L7RULE_TYPE_SSL_VERIFY_RESULT %}
        acl {{ l7rule.id }} ssl_c_verify eq {{ l7rule.value }}
    {% elif l7rule.type == constants.L7RULE_TYPE_SSL_DN_FIELD %}
        acl {{ l7rule.id }} ssl_c_s_dn({{ l7rule.key }}) {{
            l7rule_compare_type_macro(
            constants, l7rule.compare_type) }} {{ l7rule.value }}
    {% endif %}
{% endmacro %}


{% macro l7rule_invert_macro(invert) %}
    {% if invert %}
        {{- "!" -}}
    {% endif %}
{% endmacro %}


{% macro l7rule_list_macro(constants, l7policy) %}
    {% if l7policy.https_section is defined %}
        {{- " { var(txn.octavia_https_authority_section) -m str %s }"|format(l7policy.https_section) -}}
    {% endif %}
    {% for l7rule in l7policy.l7rules %}
        {% if l7rule.type == constants.L7RULE_TYPE_GRPC_CONTENT_TYPE %}
            {{- " " -}}{{- l7rule.id -}}{{- "_single" -}}
        {% endif %}
        {{- " " -}}{{- l7rule_invert_macro(l7rule.invert) -}}{{- l7rule.id -}}
    {% endfor %}
{% endmacro %}


{% macro fixed_response_backend_name(constants, listener, response_id) -%}
    {{ constants.HAPROXY_FIXED_RESPONSE_BACKEND_PREFIX }}{{ listener.id }}-{{ response_id }}
{%- endmacro %}


{% macro policy_response_headers(listener, backend_kind, backend_id, reserved_cookie=None, reserved_header=None) %}
    {% for policy_id, target, operations in listener.get('response_header_operations_by_backend', {}).get((backend_kind, backend_id), []) %}
        {# A backend modifier applies only when this occurrence receives an
           upstream response. Rule modifiers also apply to local responses. #}
        {% set phase = 'http-response' if target else 'http-after-response' %}
        {% set selected = weighted_target_match_macro(policy_id, target) if target else selected_policy_match_macro(policy_id) %}
        {% for operation in operations %}
            {% set parts = operation.split(' ', 2) %}
            {# The renderer quotes literal operation values. Ignore
               modifiers targeting the reserved cookie, including SET
               which would otherwise delete unrelated cookies. #}
            {% set targets_reserved = reserved_cookie and parts|length == 3 and parts[1]|lower == '"set-cookie"' and parts[2].split('=', 1)[0][1:].strip() == reserved_cookie %}
            {% if not targets_reserved and parts[1] != reserved_header %}
    {{ phase }} {{ operation|safe }} if {{ selected }}
            {% endif %}
        {% endfor %}
    {% endfor %}
{% endmacro %}


{% macro joined_request_header(name, separator) -%}
"req.hdrs,regsub(\"(^|[\x0d\x0a]+)({{ name }}: ([^\x0d\x0a]*)|[^\x0d\x0a]*)\",\"\\1\\3\",gi),regsub(\"^[\x0d\x0a]+|[\x0d\x0a]+\x24\",\"\",g),regsub(\"[\x0d\x0a]+\",\"{{ separator }}\",g)"
{%- endmacro %}


{% macro cors_request(policies) %}
    {% if policies %}
    acl octavia_cors_preflight var(txn.octavia_cors_preflight) -m bool
    acl octavia_cors_credentialed req.fhdr_cnt(cookie) gt 0
    acl octavia_cors_credentialed req.fhdr_cnt(authorization) gt 0
    acl octavia_cors_credentialed ssl_c_used
    {% endif %}
    {% for policy_id, cors in policies %}
        {% set selected = selected_policy_match_macro(policy_id) %}
        {% set origin_acl = 'octavia_cors_origin_' ~ policy_id %}
        {% set method_acl = 'octavia_cors_method_' ~ policy_id %}
        {% for pattern in cors.origin_patterns %}
    acl {{ origin_acl }} req.fhdr(origin) -m reg -i {{ pattern|safe }}
        {% endfor %}
        {% if cors.methods_wildcard %}
    acl {{ method_acl }} req.fhdr(access-control-request-method) -m reg {{ cors.method_token_pattern|safe }}
        {% else %}
    acl {{ method_acl }} req.fhdr(access-control-request-method) -m str {{ cors.accepted_methods|safe }}
        {% endif %}
    http-request set-var(txn.octavia_cors_preflight) bool(true) if {{ selected }} METH_OPTIONS { req.fhdr_cnt(origin) gt 0 } { req.fhdr_cnt(access-control-request-method) gt 0 }
        {% if cors.origin_patterns %}
    http-request set-var(txn.octavia_cors_origin) req.fhdr(origin) if {{ selected }} { req.fhdr_cnt(origin) eq 1 } {{ origin_acl }}
        {% endif %}
    http-request return status 403 if {{ selected }} octavia_cors_preflight !{ var(txn.octavia_cors_origin) -m found }
    http-request return status 403 if {{ selected }} octavia_cors_preflight !{ req.fhdr_cnt(access-control-request-method) eq 1 }
    http-request return status 403 if {{ selected }} octavia_cors_preflight !{{ method_acl }}
        {% if cors.header_list_pattern %}
            {% set capture = selected ~ ' { var(txn.octavia_cors_origin) -m found }' %}
            {% if not (cors.headers_wildcard and cors.credentials) %}
                {% set capture = capture ~ ' octavia_cors_preflight' %}
            {% endif %}
    http-request set-var(txn.octavia_cors_headers) req.fhdr(access-control-request-headers) if {{ capture }} { req.fhdr_cnt(access-control-request-headers) eq 1 }
    {# Extract and join repeated field lines. The config parser decodes the
       CR/LF escapes in outer double quotes for both libc and PCRE2 builds. #}
    http-request set-var(txn.octavia_cors_headers) {{ joined_request_header('access-control-request-headers', ', ') }} if {{ capture }} { req.fhdr_cnt(access-control-request-headers) gt 1 }
    http-request unset-var(txn.octavia_cors_headers) if {{ capture }} !{ var(txn.octavia_cors_headers) -m reg -i {{ cors.header_list_pattern|safe }} }
    http-request unset-var(txn.octavia_cors_headers) if {{ capture }} { var(txn.octavia_cors_headers) -m reg ",[\x09 ]*\x24" }
            {% if cors.headers_wildcard and cors.credentials %}
    http-request unset-var(txn.octavia_cors_headers) if {{ capture }} { var(txn.octavia_cors_headers) -m reg "(^|,)[\x09 ]*[*][\x09 ]*(,|\x24)" }
            {% endif %}
        {% endif %}
    http-request return status 403 if {{ selected }} octavia_cors_preflight { req.fhdr_cnt(access-control-request-headers) gt 0 } !{ var(txn.octavia_cors_headers) -m found }
        {% if cors.methods_wildcard and cors.credentials %}
    http-request set-var(txn.octavia_cors_method) req.fhdr(access-control-request-method) if {{ selected }} { var(txn.octavia_cors_origin) -m found } { req.fhdr_cnt(access-control-request-method) eq 1 } {{ method_acl }} !{ req.fhdr(access-control-request-method) -m str * }
    http-request return status 403 if {{ selected }} octavia_cors_preflight !{ var(txn.octavia_cors_method) -m found }
        {% elif cors.methods_wildcard %}
    http-request set-var(txn.octavia_cors_method) req.fhdr(access-control-request-method) if {{ selected }} octavia_cors_preflight
        {% endif %}
    http-request set-var(txn.octavia_cors_allowed) bool(true) if {{ selected }} { var(txn.octavia_cors_origin) -m found }
        {% if not cors.credentials %}
    http-request unset-var(txn.octavia_cors_allowed) if {{ selected }} !octavia_cors_preflight octavia_cors_credentialed
        {% endif %}
    http-request return status 204 if {{ selected }} octavia_cors_preflight
    {% endfor %}
{% endmacro %}


{% macro cors_response(policies) %}
    {% for policy_id, cors in policies %}
        {% set selected = selected_policy_match_macro(policy_id) %}
        {% set allowed = selected ~ ' { var(txn.octavia_cors_allowed) -m bool }' %}
        {% set preflight = '{ var(txn.octavia_cors_preflight) -m bool }' %}
        {% for name in ('Allow-Origin', 'Allow-Credentials', 'Allow-Methods',
                        'Allow-Headers', 'Expose-Headers', 'Max-Age') %}
    http-after-response del-header Access-Control-{{ name }} if {{ selected }}
        {% endfor %}
        {% for name, varies_for_actual in (
                ('Origin', true),
                ('Access-Control-Request-Method', cors.credentials and cors.methods_wildcard),
                ('Access-Control-Request-Headers', cors.credentials and cors.headers_wildcard)) %}
    http-after-response add-header Vary {{ name }} if {{ selected }}{% if not varies_for_actual %} {{ preflight }}{% endif %} !{ res.hdr(vary) -m str -i {{ name }} * }
        {% endfor %}
        {% if not cors.credentials %}
            {% for name in ('Cookie', 'Authorization') %}
    http-after-response add-header Vary {{ name }} if {{ selected }} !{{ preflight }} !{ res.hdr(vary) -m str -i {{ name }} * }
            {% endfor %}
        {% endif %}
    http-after-response set-header Access-Control-Allow-Origin {{ cors.origin_response|safe }} if {{ allowed }}
        {% if cors.credentials %}
    http-after-response set-header Access-Control-Allow-Credentials true if {{ allowed }}
        {% endif %}
        {% for name, value in cors.response_headers.items() %}
    http-after-response set-header {{ name }} {{ value|safe }} if {{ allowed }}
        {% endfor %}
        {% if cors.methods_wildcard %}
    http-after-response set-header Access-Control-Allow-Methods "%[var(txn.octavia_cors_method)]" if {{ allowed }} { var(txn.octavia_cors_method) -m found }
        {% endif %}
        {% if cors.headers_wildcard %}
    http-after-response set-header Access-Control-Allow-Headers "%[var(txn.octavia_cors_headers)]" if {{ allowed }} { var(txn.octavia_cors_headers) -m found }
        {% endif %}
    http-after-response set-header Access-Control-Max-Age {{ cors.max_age }} if {{ allowed }} {{ preflight }}
        {% if cors.expose_wildcard and cors.credentials %}
    {# Double the commas so adjacent forbidden names match independently. #}
    http-after-response set-header Access-Control-Expose-Headers '%[res.hdr_names,regsub(",",",,",g),regsub("(^|,)(set-cookie2?|[*])(,|$)","",gi),regsub(",+",",",g),regsub("^,|,$","",g)]' if {{ allowed }}
        {% elif cors.expose_wildcard %}
    http-after-response set-header Access-Control-Expose-Headers "*" if {{ allowed }}
        {% endif %}
    {% endfor %}
{% endmacro %}


{% macro fixed_response_backend_macro(constants, listener, response_id, status_code) %}
backend {{ fixed_response_backend_name(constants, listener, response_id) }}
    mode http
    {% set cors = listener.get('cors_by_backend', {}).get(('fixed', response_id), []) %}
{{ cors_request(cors) }}{{ mirrored_rule_requests(listener, 'fixed', response_id) }}    http-request return status {{ status_code }}
{{ policy_response_headers(listener, 'fixed', response_id) -}}
{{ cors_response(cors) -}}

{% endmacro %}


{% macro request_redirect_backend_name(listener, policy) -%}
    request-redirect-{{ listener.id }}-{{ policy.id }}
{%- endmacro %}


{% macro request_redirect_backend_macro(listener, policy) %}
    {% set redirect = policy.request_redirect %}
    {% set code = policy.redirect_http_code or 302 %}
backend {{ request_redirect_backend_name(listener, policy) }}
    mode http
    {% if redirect.request_hostname %}
    http-request deny deny_status 400 unless { req.fhdr(host) -m reg '^([A-Za-z0-9.-]+|\[[A-Fa-f0-9:.]+\])(:[0-9]*)?$' }
    {% endif %}
    http-request redirect code {{ code }} {{ redirect.mode }} {{ redirect.argument|safe }}

{% endmacro %}


{% macro closed_backend_macro(listener, pool) %}
{# An empty backend returns 503 in HTTP mode and closes TCP connections. #}
backend {{ pool.id }}:{{ listener.id }}
    mode {{ listener.protocol_mode }}
    timeout connect {{ listener.timeout_member_connect }}
    timeout server {{ listener.timeout_member_data }}
    {% if pool.header_persistence_unavailable %}
{{ system_ca_file(pool) -}}
    {% else %}
        {% set cors = listener.get('cors_by_backend', {}).get(('pool', pool.id), []) %}
{{ cors_request(cors) -}}
{{ mirrored_rule_requests(listener, 'pool', pool.id) -}}
{{ policy_response_headers(listener, 'pool', pool.id) -}}
{{ cors_response(cors) -}}
    {% endif %}

{% endmacro %}


{% macro l7policy_rules_macro(constants, l7policy, listener, raw_tls=False) %}
    {% for l7rule in l7policy.l7rules %}
        {{- l7rule_macro(constants, l7rule, listener, raw_tls) -}}
    {% endfor %}
    {% if l7policy.request_redirect is defined and l7policy.request_redirect.match is defined %}
    acl redirect-prefix-{{ l7policy.id }} path -m str -- {{ l7policy.request_redirect.match|safe }}
    acl redirect-prefix-{{ l7policy.id }} path -m beg -- {{ l7policy.request_redirect.descendants|safe }}
    {% endif %}
{% endmacro %}


{% macro selected_policy_match_macro(policy_id) -%}
    { var(txn.octavia_l7_policy) -m str {{ policy_id }} }
{%- endmacro %}


{% macro selected_request_operation(operation, match) -%}
    {% if operation.startswith('octavia-grpc-mirror ') %}
    http-request {{ operation|safe }} if {{ match }} { var(txn.octavia_grpc_mirror) -m bool }
    http-request {{ operation|replace('octavia-grpc-mirror ', 'octavia-mirror ', 1)|safe }} if {{ match }} !{ var(txn.octavia_grpc_mirror) -m bool }
    {% else %}
    http-request {{ operation|safe }} if {{ match }}
    {% endif %}
{%- endmacro %}


{% macro mirrored_rule_requests(listener, backend_type, backend_id) -%}
    {% for policy_id, operations in listener.get('mirrored_rules_by_backend', {}).get((backend_type, backend_id), []) %}
        {% for operation in operations %}
            {{- selected_request_operation(operation, selected_policy_match_macro(policy_id)) -}}
        {% endfor %}
    {% endfor %}
{%- endmacro %}


{% macro request_redirect_match_macro(constants, policy) -%}
    {{- l7rule_list_macro(constants, policy) -}}
    {%- if policy.request_redirect.match is defined %} redirect-prefix-{{ policy.id }}{% endif -%}
{%- endmacro %}


{% macro ordered_redirect_match_macro() -%}
    { var(txn.octavia_ordered_redirect) -m found }
{%- endmacro %}


{% macro stock_redirect_macro(constants, policy, unless_ordered=False, auth_mode=False) %}
    {% set code = (" code %s"|format(policy.redirect_http_code)) if policy.redirect_http_code else "" %}
    {% if policy.action == constants.L7POLICY_ACTION_REDIRECT_TO_URL %}
        {% set mode = "location" %}
        {% set destination = policy.redirect_url %}
    {% else %}
        {% set mode = "prefix" %}
        {% set destination = policy.redirect_prefix %}
    {% endif %}
    redirect{{ code }} {{ mode }} {{ destination }} if{% if auth_mode %} { var(txn.octavia_legacy_redirect) -m found }{% endif %}{% if unless_ordered %} !{{ ordered_redirect_match_macro() }}{% endif %}{{ l7rule_list_macro(constants, policy) }}
{% endmacro %}


{% macro select_switching_policy_macro(constants, l7policy, auth_mode=False) %}
    {% if auth_mode and l7policy.request_redirect is defined %}
        {% set match = request_redirect_match_macro(constants, l7policy) %}
        {% if l7policy.action != constants.L7POLICY_ACTION_REDIRECT_REQUEST %}
            {% set match = ' ' ~ ordered_redirect_match_macro() ~ match %}
        {% endif %}
    {% elif l7policy.weighted_targets is defined or
          (auth_mode and l7policy.external_auth is defined) or
          l7policy.fixed_http_status_code is defined or
          (l7policy.action == constants.L7POLICY_ACTION_REDIRECT_TO_POOL and
           l7policy.redirect_pool and
           (l7policy.redirect_pool.enabled or l7policy.redirect_pool.closed)) %}
        {% set match = l7rule_list_macro(constants, l7policy) %}
    {% endif %}
    {% if match is defined %}
    http-request set-var(txn.octavia_l7_policy) str({{ l7policy.id }}) if !{ var(txn.octavia_l7_policy) -m found }{% if auth_mode %} !{ var(txn.octavia_legacy_redirect) -m found }{% endif %}{{ match }}
        {% if l7policy.weighted_targets is defined %}
    http-request set-var(txn.octavia_weighted_draw) rand({{ l7policy.total_weight }}) if {{ selected_policy_match_macro(l7policy.id) }}
        {% endif %}
    {% endif %}
{% endmacro %}


{% macro weighted_target_match_macro(policy_id, target) -%}
    {{ selected_policy_match_macro(policy_id) }} { var(txn.octavia_weighted_draw) -m int {{ target.first }}:{{ target.last }} }
{%- endmacro %}


{% macro l7policy_macro(constants, l7policy, listener, auth_mode=False) %}
    {% set match = (' ' ~ selected_policy_match_macro(l7policy.id)) if auth_mode else l7rule_list_macro(constants, l7policy) %}
    {% if l7policy.action == constants.L7POLICY_ACTION_REJECT %}
        {% if not auth_mode %}
    http-request deny if{{ match }}
        {% endif %}
    {% elif l7policy.request_redirect is defined %}
        {% if not auth_mode %}
            {% set ordered = ' ' ~ ordered_redirect_match_macro() if l7policy.action != constants.L7POLICY_ACTION_REDIRECT_REQUEST else '' %}
            {% set match = ordered ~ request_redirect_match_macro(constants, l7policy) %}
        {% endif %}
    use_backend {{ request_redirect_backend_name(listener, l7policy) }} if{{ match }}
    {% elif l7policy.action in (constants.L7POLICY_ACTION_REDIRECT_TO_URL, constants.L7POLICY_ACTION_REDIRECT_PREFIX) %}
        {{- stock_redirect_macro(constants, l7policy, auth_mode=auth_mode) -}}
    {% elif l7policy.action == constants.L7POLICY_ACTION_REDIRECT_TO_POOL and
            (l7policy.redirect_pool.enabled or l7policy.redirect_pool.closed) %}
    use_backend {{ l7policy.redirect_pool.id }}:{{ listener.id }} if{{ match }}
    {% elif l7policy.action == constants.L7POLICY_ACTION_FIXED_RESPONSE %}
    {# Keep status responses in the same ordered switching stage as pools. #}
    use_backend {{ fixed_response_backend_name(constants, listener, l7policy.id) }} if{{ match }}
    {% elif l7policy.weighted_targets is defined %}
        {% for target in l7policy.weighted_targets %}
            {% if target.pool_id is defined %}
                {% set backend = target.pool_id ~ ':' ~ listener.id %}
            {% else %}
                {% set backend = fixed_response_backend_name(constants, listener, 'weighted-' ~ target.status_code) %}
            {% endif %}
    use_backend {{ backend }} if {{ weighted_target_match_macro(l7policy.id, target) }}
        {% endfor %}
    {% endif %}
{% endmacro %}


{% macro https_section_condition(fetch, dns_acl, hostname) -%}
    {%- if hostname == '*' -%}
        {%- if fetch != 'ssl_fc_sni' %} { {{ fetch }} -m found }{% endif -%}
    {%- elif hostname.startswith('*.') %} { {{ fetch }} -m end -i {{ hostname[1:] }} } {{ dns_acl }}
    {%- else %} { {{ fetch }} -m str -i {{ hostname }} }
    {%- endif -%}
{%- endmacro %}


{% macro https_listener_isolation_macro(sections) %}
    {% set dns_label = '[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?' %}
    {% set dns_name = '^(' ~ dns_label ~ '[.])+' ~ dns_label ~ '$' %}
    acl octavia_https_sni_dns ssl_fc_sni -m reg -i {{ dns_name }}
    acl octavia_https_authority_dns var(txn.octavia_https_authority) -m reg -i {{ dns_name }}
    http-request set-var(txn.octavia_https_authority) req.fhdr(host),host_only
    {% for hostname, section in sections.items() %}
    http-request set-var(txn.octavia_https_sni_section) str({{ section }}) if !{ var(txn.octavia_https_sni_section) -m found }{{ https_section_condition('ssl_fc_sni', 'octavia_https_sni_dns', hostname) }}
    http-request set-var(txn.octavia_https_authority_section) str({{ section }}) if !{ var(txn.octavia_https_authority_section) -m found }{{ https_section_condition('var(txn.octavia_https_authority)', 'octavia_https_authority_dns', hostname) }}
    {% endfor %}
    http-request return status 404 unless { var(txn.octavia_https_authority_section) -m found }
    http-request return status 421 unless { var(txn.octavia_https_authority_section),strcmp(txn.octavia_https_sni_section) -m int eq 0 }
{% endmacro %}


{% macro authorization_request_macro(auth, condition) %}
    {% if auth.available and auth.get('protocol') == 'GRPC' %}
        {% if auth.forward_body_max_size is defined %}
    http-request octavia-collect-body {{ auth.forward_body_max_size }} if {{ condition }}
    http-request lua.octavia-grpc-auth-body {{ auth.pool_id }} {{ auth.request_headers }} {{ auth.forward_body_max_size }} if {{ condition }}
        {% else %}
    http-request lua.octavia-grpc-auth {{ auth.pool_id }} {{ auth.request_headers }} if {{ condition }}
        {% endif %}
    http-request use-service lua.octavia-grpc-auth-denial if {{ condition }} { var(txn.octavia_grpc_auth_denied) -m bool }
    http-request return status 503 if {{ condition }} !{ var(txn.octavia_grpc_auth_allowed) -m bool }
    {% elif auth.available %}
    http-request octavia-auth /run/octavia/listener-auth/{{ auth.pool_id }}.sock {{ auth.prefix }} {{ auth.request_headers }} {{ auth.response_headers }}{% if auth.forward_body_max_size is defined %} {{ auth.forward_body_max_size }}{% endif %} if {{ condition }}
    {% else %}
    http-request deny deny_status 503 if {{ condition }}
    {% endif %}
{% endmacro %}


{% macro listener_request_filters_macro(constants, listener) %}
    {% set sections = listener.request_filter_sections %}
    {% set tls = listener.protocol == constants.PROTOCOL_TERMINATED_HTTPS %}
    {% set dns_label = '[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?' %}
    {% set dns_name = '^(' ~ dns_label ~ '[.])+' ~ dns_label ~ '$' %}
    {% set fetch = 'ssl_fc_sni' if tls else 'var(txn.octavia_auth_authority)' %}
    {% if not tls %}
    http-request set-var(txn.octavia_auth_authority) req.fhdr(host),host_only
    {% endif %}
    acl octavia_auth_dns {{ fetch }} -m reg -i {{ dns_name }}
    {% for section in sections %}
    http-request set-var(txn.octavia_auth_section) int({{ section.id }}) if !{ var(txn.octavia_auth_section) -m found }{% if section.hostname != '*' %}{{ https_section_condition(fetch, 'octavia_auth_dns', section.hostname) }}{% endif %}

    {% endfor %}
    http-request return status {{ 421 if tls else 404 }} unless { var(txn.octavia_auth_section) -m found }
    {% for section in sections %}
        {% set condition = '{ var(txn.octavia_auth_section) -m int eq ' ~ section.id ~ ' }' %}
        {% if section.reject %}
    http-request deny deny_status 403 if {{ condition }}
        {% endif %}
        {% for auth in section.requests %}
            {{- authorization_request_macro(auth, condition) -}}
        {% endfor %}
    {% endfor %}
{% endmacro %}


{% macro tcp_sni_draw_macro(constants, policies, raw_tls=False, mixed_mode=False) %}
    {% set hello = ' { req.ssl_hello_type 1 }' if raw_tls else '' %}
    {% for policy in policies %}
        {% if policy.tcp_weighted_targets and (not mixed_mode or policy.tcp_tls_passthrough) %}
    tcp-request content set-var(sess.octavia_sni_weighted_draw) rand({{ policy.total_weight }}) if{{ hello }}{{ l7rule_list_macro(constants, policy) }}
        {% endif %}
    tcp-request content accept if{{ hello }}{{ l7rule_list_macro(constants, policy) }}
    {% endfor %}
    {% if raw_tls %}
    tcp-request content accept if{{ hello }}
    {% endif %}
{% endmacro %}


{% macro tcp_sni_weighted_backends_macro(constants, listener, policy) %}
    {% set closed = constants.HAPROXY_TLS_SNI_WEIGHTED_CLOSED_PREFIX ~ listener.id %}
    {% for target in policy.tcp_weighted_targets %}
        {% set backend = target.pool_id ~ ':' ~ listener.id if target.pool_id is defined else closed %}
    use_backend {{ backend }} if{{ l7rule_list_macro(constants, policy) }} { var(sess.octavia_sni_weighted_draw) -m int {{ target.first }}:{{ target.last }} }
    {% endfor %}
    use_backend {{ closed }} if{{ l7rule_list_macro(constants, policy) }}
{% endmacro %}


{% macro tcp_sni_policies_macro(constants, listener, policies) %}
    {% for policy in policies %}
        {{- l7policy_rules_macro(constants, policy, listener) -}}
    {% endfor %}
    {{- tcp_sni_draw_macro(constants, policies, raw_tls=not listener.tcp_tls_termination) -}}
    {% for policy in policies %}
        {% if policy.tcp_weighted_targets is defined %}
            {{- tcp_sni_weighted_backends_macro(constants, listener, policy) -}}
        {% else %}
            {{- l7policy_macro(constants, policy, listener) -}}
        {% endif %}
    {% endfor %}
{% endmacro %}


{% macro frontend_macro(constants, lib_consts, listener, lb_vip_address, additional_vips) %}
frontend {{ listener.id }}
    {% set policies = listener.l7policies|selectattr('enabled')|selectattr('l7rules')|list %}
    {% set route_auth = policies|selectattr('external_auth', 'defined')|list %}
    {% if listener.otlp_tracing is defined %}
    http-request lua.{{ listener.otlp_tracing.action_prefix }}-start {{ listener.id }}
    http-after-response lua.{{ listener.otlp_tracing.action_prefix }}-finish
    {% endif %}
    {% if listener.connection_limit is defined %}
    maxconn {{ listener.connection_limit }}
    {% endif %}
    {% if (listener.protocol.lower() ==
       constants.PROTOCOL_TERMINATED_HTTPS.lower()) %}
        {% if listener.https_sections is not defined %}
            {% if listener.request_filter_sections is defined or route_auth %}
    http-request redirect scheme https if !{ ssl_fc }
            {% else %}
    redirect scheme https if !{ ssl_fc }
            {% endif %}
        {% endif %}
        {% if listener.hsts_directives is defined %}
    http-response set-header Strict-Transport-Security "{{ listener.hsts_directives }}"
        {% endif %}
    {% endif %}
    {{ bind_macro(constants, lib_consts, listener, lb_vip_address)|trim() }}
    {% for add_vip in additional_vips %}
    {{ bind_macro(constants, lib_consts, listener, add_vip)|trim() }}
    {% endfor %}
    mode {{ listener.protocol_mode }}
    {% if listener.request_mirror_pools is defined %}
    filter octavia-mirror /run/octavia/mirror
    {% endif %}
    {% if listener.grpc_mirror_media_acl is defined %}
    {# Classify the original request before route and target header filters. #}
    acl octavia_grpc_mirror_media req.fhdr(content-type) -m reg -i {{ listener.grpc_mirror_media_acl|safe }}
    http-request set-var(txn.octavia_grpc_mirror) bool(true) if METH_POST { fc_http_major eq 2 } { req.fhdr_cnt(content-type) eq 1 } octavia_grpc_mirror_media
    {% endif %}
    {% set listener_auth = listener.get('request_filter_sections', [])|map(attribute='requests')|sum(start=[]) %}
    {% set ready_auth = route_auth|map(attribute='external_auth')|selectattr('available')|list %}
    {% if listener_auth|selectattr('available')|list or ready_auth|rejectattr('protocol', 'defined')|list %}
    filter octavia-auth
    {% endif %}
    {% if ready_auth|selectattr('protocol', 'defined')|selectattr('protocol', 'equalto', 'GRPC')|list %}
    http-response lua.octavia-grpc-auth-response if { var(txn.octavia_grpc_auth_allowed) -m bool }
    http-response return status 503 if { var(txn.octavia_grpc_auth_allowed) -m bool } !{ var(txn.octavia_grpc_auth_response_applied) -m bool }
    http-after-response lua.octavia-grpc-auth-response if { var(txn.octavia_grpc_auth_allowed) -m bool } !{ var(txn.octavia_grpc_auth_response_applied) -m bool }
    http-after-response set-status 503 if { var(txn.octavia_grpc_auth_allowed) -m bool } !{ var(txn.octavia_grpc_auth_response_applied) -m bool }
    {% endif %}
    {% set tcp_weighted = policies|selectattr('tcp_weighted_targets', 'defined')|list %}
    {% if listener.inspect_tls_sni is defined %}
    tcp-request inspect-delay {{ listener.timeout_tcp_inspect }}
        {% if not tcp_weighted %}
    tcp-request content accept if { req.ssl_hello_type 1 }
        {% endif %}
    {% endif %}
    {% if listener.https_sections is defined %}
        {{- https_listener_isolation_macro(listener.https_sections) -}}
    {% endif %}
    {% if listener.request_filter_sections is defined %}
        {{- listener_request_filters_macro(constants, listener) -}}
    {% endif %}
    {% set structured = policies|selectattr('action', 'equalto', constants.L7POLICY_ACTION_REDIRECT_REQUEST)|list %}
    {% set select_policy = route_auth or listener.weighted_response_codes is defined or
                           listener.request_header_operations_by_pool is defined or
                           listener.response_header_operations_by_backend is defined or
                           listener.request_url_rewrites_by_pool is defined or
                           listener.http_request_policies_by_pool is defined or
                           listener.request_mirror_pools is defined or
                           listener.cors_by_backend is defined %}
    {% if select_policy or structured %}
        {% for l7policy in policies %}
            {{- l7policy_rules_macro(constants, l7policy, listener) -}}
        {% endfor %}
    {% endif %}
    {% if structured %}
        {# Enter the ordered phase only for requests with a structured match. #}
        {% for l7policy in structured %}
    http-request set-var(txn.octavia_ordered_redirect) bool(true) if !{{ ordered_redirect_match_macro() }}{{ request_redirect_match_macro(constants, l7policy) }}
        {% endfor %}
    {% endif %}
    {% if route_auth %}
        {# Stock rejects and redirects precede backend selection. Capture the
           legacy redirects before an authorization response can add headers. #}
        {% for l7policy in policies if l7policy.action == constants.L7POLICY_ACTION_REJECT %}
    http-request deny if{{ l7rule_list_macro(constants, l7policy) }}
        {% endfor %}
        {% for l7policy in policies if l7policy.action in (constants.L7POLICY_ACTION_REDIRECT_TO_URL, constants.L7POLICY_ACTION_REDIRECT_PREFIX) %}
    http-request set-var(txn.octavia_legacy_redirect) bool(true) if !{{ ordered_redirect_match_macro() }}{{ l7rule_list_macro(constants, l7policy) }}
        {% endfor %}
    {% endif %}
    {% if select_policy %}
        {# Match the first eligible switching policy before sampling. Only a
           weighted winner draws, and txn variables are reset per request. #}
        {% for l7policy in policies %}
            {{- select_switching_policy_macro(constants, l7policy, auth_mode=route_auth) -}}
        {% endfor %}
    {% endif %}
    {% for l7policy in route_auth %}
        {{- authorization_request_macro(l7policy.external_auth, selected_policy_match_macro(l7policy.id)) -}}
    {% endfor %}
    {% if structured %}
        {% for l7policy in policies if l7policy.request_redirect is defined and l7policy.action != constants.L7POLICY_ACTION_REDIRECT_REQUEST %}
            {{- stock_redirect_macro(constants, l7policy, unless_ordered=True, auth_mode=route_auth) -}}
        {% endfor %}
    {% endif %}
    {% if tcp_weighted %}
        {{- tcp_sni_policies_macro(constants, listener, policies) -}}
    {% else %}
        {% for l7policy in policies %}
            {% if not (select_policy or structured) %}
                {{- l7policy_rules_macro(constants, l7policy, listener) -}}
            {% endif %}
            {{- l7policy_macro(constants, l7policy, listener, auth_mode=route_auth) -}}
        {% endfor %}
    {% endif %}
    {% if listener.default_http_status_code is defined %}
    default_backend {{ fixed_response_backend_name(constants, listener, 'default') }}
    {% elif listener.default_pool and
            (listener.default_pool.enabled or listener.default_pool.closed) %}
    default_backend {{ listener.default_pool.id }}:{{ listener.id }}
    {% endif %}
    timeout client {{ listener.timeout_client_data }}
    {% if listener.timeout_tcp_inspect and listener.inspect_tls_sni is not defined and not listener.tcp_tls_termination %}
    tcp-request inspect-delay {{ listener.timeout_tcp_inspect }}
    {% endif %}
    {% if listener.protocol == lib_consts.PROTOCOL_PROMETHEUS and
          listener.get(lib_consts.PROTOCOL_PROMETHEUS, False) %}
    default_backend prometheus-exporter-internal
    {% endif %}
    {% if listener.user_log_format is defined %}
    log-format {{ listener.user_log_format }}
    {% endif %}
{% endmacro %}


{% macro mixed_tls_frontend_macro(constants, lib_consts, listener, lb_vip_address, additional_vips) %}
    {% set local_proxy = constants.HAPROXY_TCP_TLS_MIXED_PREFIX ~ listener.id %}
    {% set local_frontend = local_proxy ~ '-terminate' %}
    {% set dispatch = local_proxy ~ '-dispatch' %}
    {% set reject = local_proxy ~ '-reject' %}
    {% set local_socket = 'abns@' ~ local_frontend %}
    {% set dns_label = '[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?' %}
    {% set dns_name = '^(' ~ dns_label ~ '[.])*' ~ dns_label ~ '$' %}
frontend {{ listener.id }}
    mode tcp
    maxconn {{ listener.connection_limit }}
    bind {{ lb_vip_address }}:{{ listener.protocol_port }}
    {% for add_vip in additional_vips %}
    bind {{ add_vip }}:{{ listener.protocol_port }}
    {% endfor %}
    timeout client {{ listener.timeout_client_data }}
    {% if listener.user_log_format is defined %}
    log-format {{ listener.user_log_format }}
    {% endif %}
    {% if listener.l7policies %}
    tcp-request inspect-delay {{ listener.timeout_tcp_inspect }}
    acl octavia_mixed_hello req.ssl_hello_type 1
    acl octavia_mixed_sni_dns req.ssl_sni -m reg -i {{ dns_name }}
    acl octavia_mixed_sni_length req.ssl_sni,length -m int 1:253
    tcp-request content reject if octavia_mixed_hello !octavia_mixed_sni_length
    tcp-request content reject if octavia_mixed_hello !octavia_mixed_sni_dns
        {% if listener.mixed_tls_termination %}
    tcp-request content set-var(sess.octavia_mixed_sni) req.ssl_sni,lower if octavia_mixed_hello
        {% endif %}
        {% for policy in listener.l7policies %}
            {{- l7policy_rules_macro(constants, policy, listener, raw_tls=True) -}}
        {% endfor %}
        {% if listener.l7policies|selectattr('tcp_tls_passthrough')|selectattr('tcp_weighted_targets', 'defined')|list %}
            {{- tcp_sni_draw_macro(constants, listener.l7policies, raw_tls=True, mixed_mode=True) -}}
        {% else %}
    tcp-request content accept if octavia_mixed_hello
        {% endif %}
        {% for policy in listener.l7policies %}
            {% if policy.tcp_weighted_targets is defined and policy.tcp_tls_passthrough %}
                {{- tcp_sni_weighted_backends_macro(constants, listener, policy) -}}
            {% else %}
                {% if policy.tcp_weighted_targets is defined and not policy.tcp_weighted_targets %}
                    {% set target = constants.HAPROXY_TLS_SNI_WEIGHTED_CLOSED_PREFIX ~ listener.id %}
                {% elif not policy.tcp_tls_passthrough %}
                    {% set target = dispatch %}
                {% elif policy.redirect_pool.tls_enabled or policy.redirect_pool.backend_tls_hostname is defined %}
                    {% set target = reject %}
                {% else %}
                    {% set target = policy.redirect_pool.id ~ ':' ~ listener.id %}
                {% endif %}
    use_backend {{ target }} if{{ l7rule_list_macro(constants, policy) }}
            {% endif %}
        {% endfor %}
    {% else %}
    tcp-request content reject
    {% endif %}

    {% if listener.mixed_tls_termination %}
frontend {{ local_frontend }}
    mode tcp
    no log
    {{ bind_macro(constants, lib_consts, listener, lb_vip_address, local_socket)|trim() }}
    timeout client {{ listener.timeout_client_data }}
    {# Require the TLS stack to see the same name as the public dispatcher. #}
    tcp-request content set-var(sess.octavia_mixed_sni) fc_pp_tlv(0xe0)
    tcp-request content reject unless { ssl_fc_sni,lower,strcmp(sess.octavia_mixed_sni) -m int eq 0 }
        {% set terminating_policies = listener.l7policies|rejectattr('tcp_tls_passthrough')|list %}
        {% if terminating_policies|selectattr('tcp_weighted_targets', 'defined')|list %}
            {{- tcp_sni_policies_macro(constants, listener, terminating_policies) -}}
        {% else %}
            {% for policy in terminating_policies %}
                {{- l7policy_rules_macro(constants, policy, listener) -}}
                {{- l7policy_macro(constants, policy, listener) -}}
            {% endfor %}
        {% endif %}

backend {{ dispatch }}
    mode tcp
    timeout connect {{ listener.timeout_member_connect }}
    timeout server {{ listener.timeout_member_data }}
    server local {{ local_socket }} send-proxy-v2 set-proxy-v2-tlv-fmt(0xe0) %[var(sess.octavia_mixed_sni)]
    {% endif %}
    {% if listener.mixed_tls_reject %}

backend {{ reject }}
    mode tcp
    timeout connect {{ listener.timeout_member_connect }}
    timeout server {{ listener.timeout_member_data }}
    {% endif %}
{% endmacro %}


{% macro system_ca_file(pool) %}
    {# HAProxy loads this CA file even if no member exists yet. #}
    {% if pool.backend_tls_system_ca_sha256 is defined %}
    default-server ca-file {{ pool.ca_cert }}
    {% endif %}
{% endmacro %}


{% macro member_macro(constants, lib_consts, pool, member, persistence=True) %}
    {% if pool.health_monitor and pool.health_monitor.enabled %}
        {% if member.monitor_address %}
            {% set monitor_addr_opt = " addr %s"|format(member.monitor_address) %}
        {% else %}
            {% set monitor_addr_opt = "" %}
        {% endif %}
        {% if member.monitor_port %}
            {% set monitor_port_opt = " port %s"|format(member.monitor_port) %}
        {% else %}
            {% set monitor_port_opt = "" %}
        {% endif %}
        {% if pool.backend_tls_require_h2 %}
            {% set alpn_opt = " check-alpn h2" %}
        {% elif pool.alpn_protocols is defined %}
            {% set alpn_opt = " check-alpn %s"|format(pool.alpn_protocols) %}
        {% else %}
            {% set alpn_opt = "" %}
        {% endif %}
        {% if pool.backend_tls_hostname %}
            {% set monitor_ssl_opt = " check-ssl check-sni %s"|format(pool.backend_tls_hostname) %}
        {% elif pool.health_monitor.type == constants.HEALTH_MONITOR_HTTPS %}
            {% set monitor_ssl_opt = " check-ssl verify none" %}
        {% else %}
            {% set monitor_ssl_opt = "" %}
        {% endif %}
        {% set hm_opt = " check%s%s inter %ds fall %d rise %d%s%s"|format(
            monitor_ssl_opt, alpn_opt, pool.health_monitor.delay,
            pool.health_monitor.fall_threshold,
            pool.health_monitor.rise_threshold, monitor_addr_opt,
            monitor_port_opt) %}
    {% else %}
        {% set hm_opt = "" %}
    {% endif %}
    {% if persistence and (pool.session_persistence.type ==
           constants.SESSION_PERSISTENCE_HTTP_COOKIE) and
           pool.session_persistence.absolute_timeout_us is not defined %}
        {% set persistence_opt = " cookie %s"|format(member.get('persistence_cookie', member.id)) %}
    {% else %}
        {% set persistence_opt = "" %}
    {% endif %}
    {% if pool.proxy_protocol == 1 %}
        {% set proxy_protocol_opt = " send-proxy" %}
    {% elif pool.proxy_protocol == 2 %}
        {% if pool.listener_tls_enabled %}
            {% set proxy_protocol_opt = " send-proxy-v2-ssl-cn" %}
        {% else %}
            {% set proxy_protocol_opt = " send-proxy-v2" %}
        {% endif %}
    {% else %}
        {% set proxy_protocol_opt = "" %}
    {% endif %}
    {% if member.backup %}
        {% set member_backup_opt = " backup" %}
    {% else %}
        {% set member_backup_opt = "" %}
    {% endif %}
    {% if member.enabled %}
        {% set member_enabled_opt = "" %}
    {% else %}
        {% set member_enabled_opt = " disabled" %}
    {% endif %}
    {% if pool.tls_enabled %}
        {% set def_opt_prefix = " ssl" %}
        {% if pool.backend_tls_san_options %}
            {% set def_sni_opt = " sni str(%s) verify-san %s"|format(
                pool.backend_tls_hostname,
                pool.backend_tls_san_options|join(" verify-san ")) %}
        {% elif pool.backend_tls_hostname %}
            {% set def_sni_opt = " sni str(%s) verifyhost-strict %s"|format(
                pool.backend_tls_hostname, pool.backend_tls_hostname) %}
        {% else %}
            {% set def_sni_opt = " sni ssl_fc_sni" %}
        {% endif %}
    {% else %}
        {% set def_opt_prefix = "" %}
        {% set def_sni_opt = "" %}
    {% endif %}
    {% if pool.client_cert and pool.tls_enabled %}
        {% set def_crt_opt = " crt %s"|format(pool.client_cert) %}
    {% else %}
        {% set def_crt_opt = "" %}
    {% endif %}
    {% if pool.ca_cert and pool.tls_enabled %}
        {% set ca_opt = " ca-file %s"|format(pool.ca_cert) %}
        {% set def_verify_opt = " verify required" %}
        {% if pool.crl %}
            {% set crl_opt = " crl-file %s"|format(pool.crl) %}
        {% elif not pool.backend_tls_hostname %}
            {% set def_verify_opt = "" %}
        {% endif %}
    {% elif pool.tls_enabled %}
        {% set def_verify_opt = " verify none" %}
    {% endif %}
    {% if pool.tls_ciphers is defined and pool.tls_ciphers %}
        {% set ciphers_opt = " ciphers %s"|format(pool.tls_ciphers) %}
    {% else %}
        {% set ciphers_opt = "" %}
    {% endif %}
    {% if pool.tlsv1_3_ciphers is defined and pool.tlsv1_3_ciphers %}
        {% set ciphersuites_opt = " ciphersuites %s"|format(pool.tlsv1_3_ciphers) %}
    {% else %}
        {% set ciphersuites_opt = "" %}
    {% endif %}
    {% set tls_versions_opt = "" %}
    {% if pool.tls_versions is defined %}
        {% if lib_consts.SSL_VERSION_3 not in pool.tls_versions %}
            {% set tls_versions_opt = tls_versions_opt + " no-sslv3" %}
        {% endif %}
        {% if lib_consts.TLS_VERSION_1 not in pool.tls_versions %}
            {% set tls_versions_opt = tls_versions_opt + " no-tlsv10" %}
        {% endif %}
        {% if lib_consts.TLS_VERSION_1_1 not in pool.tls_versions %}
            {% set tls_versions_opt = tls_versions_opt + " no-tlsv11" %}
        {% endif %}
        {% if lib_consts.TLS_VERSION_1_2 not in pool.tls_versions %}
