{% macro http_header_persistence_request(pool) %}
    {% set persistence = pool.session_persistence %}
    acl octavia_header_unique {{ persistence.header_count|safe }} eq 1
    acl octavia_header_format var(txn.octavia_header_in) -m reg '^v1[.][0-9a-f]{32}[.][1-9][0-9]{0,17}[.][A-Za-z0-9_-]{43}$'
    acl octavia_header_age_valid var(txn.octavia_header_age) -m int ge 0
    {% set valid_age = 'octavia_header_age_valid' %}
    {% if persistence.header_absolute_timeout_us is defined %}
    acl octavia_header_age_below_limit var(txn.octavia_header_age) -m int lt {{ persistence.header_absolute_timeout_us }}
    {% set valid_age = valid_age ~ ' octavia_header_age_below_limit' %}
    {% endif %}
    acl octavia_header_authenticated var(txn.octavia_header_payload),hmac(sha256,txn.octavia_header_signing_key),ub64enc,secure_memcmp(txn.octavia_header_tag) -m bool
    http-request set-var(txn.octavia_header_signing_key) str({{ persistence.header_signing_key }})
    http-request set-var(txn.octavia_header_in) {{ persistence.header_fetch|safe }} if octavia_header_unique
    http-request set-var(txn.octavia_header_issued) var(txn.octavia_header_in),word(3,.) if octavia_header_format
    http-request set-var(txn.octavia_header_age) date(0,us),sub(txn.octavia_header_issued) if octavia_header_format
    http-request set-var(txn.octavia_header_tag) var(txn.octavia_header_in),word(4,.) if {{ valid_age }}
    http-request set-var-fmt(txn.octavia_header_payload) "v1.%[var(txn.octavia_header_in),word(2,.)].%[var(txn.octavia_header_issued)]" if {{ valid_age }}
    http-request set-var(txn.octavia_header_member) var(txn.octavia_header_in),word(2,.) if {{ valid_age }} octavia_header_authenticated
