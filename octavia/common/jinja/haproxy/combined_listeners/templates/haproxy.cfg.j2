{% extends 'base.j2' %}


{% from 'macros.j2' import frontend_macro, mixed_tls_frontend_macro, backend_macro, closed_backend_macro, fixed_response_backend_macro, request_redirect_backend_macro %}
{% from 'macros.j2' import mirror_delivery_macro, peers_macro %}


{% set loadbalancer_id = loadbalancer.id %}
{% set sock_path = stats_sock %}


{% block peers %}
{{ peers_macro(constants, loadbalancer) }}
{% endblock peers %}

{% block prometheus %}
{% if enable_prometheus %}
frontend prometheus-exporter-internal-endpoint
    bind 127.0.0.1:9101
    mode http
    no log
    http-request use-service prometheus-exporter if { path /metrics }
    http-request reject
    timeout http-request 5s
    timeout client 5s
backend prometheus-exporter-internal
    mode http
    no log
    balance first
    timeout connect 5s
    timeout server 5s
    server prometheus-internal 127.0.0.1:9102
{% endif %}
{% endblock prometheus %}

{% block proxies %}
    {% if loadbalancer.enabled %}
         {% for listener in loadbalancer.listeners if listener.enabled %}
             {% if listener.tcp_tls_mixed_mode is defined %}
             {{- mixed_tls_frontend_macro(constants, lib_consts, listener, loadbalancer.vip_address,
                                          loadbalancer.additional_vips) }}
             {% else %}
             {{- frontend_macro(constants, lib_consts, listener, loadbalancer.vip_address,
                                loadbalancer.additional_vips) }}
             {% endif %}
             {% if listener.default_http_status_code is defined %}
               {{- fixed_response_backend_macro(constants, listener, 'default',
                                                 listener.default_http_status_code) }}
             {% endif %}
             {% for policy in listener.l7policies if policy.fixed_http_status_code is defined %}
               {{- fixed_response_backend_macro(constants, listener, policy.id,
                                                 policy.fixed_http_status_code) }}
             {% endfor %}
             {% for policy in listener.l7policies if policy.request_redirect is defined %}
               {{- request_redirect_backend_macro(listener, policy) }}
             {% endfor %}
             {% for status_code in listener.weighted_response_codes %}
               {{- fixed_response_backend_macro(constants, listener,
                     'weighted-' ~ status_code, status_code) }}
             {% endfor %}
             {% for pool in listener.pools if pool.id not in listener.get('mirror_only_pool_ids', []) %}
               {% if pool.enabled %}
                 {{- backend_macro(constants, lib_consts, listener, pool, loadbalancer, state_file) }}
               {% elif pool.closed %}
                 {{- closed_backend_macro(listener, pool) }}
               {% endif %}
             {% endfor %}
         {% endfor %}
         {% for pool in loadbalancer.get('request_mirror_pools', []) %}
           {{- mirror_delivery_macro(constants, lib_consts, pool, state_file) }}
         {% endfor %}
    {% endif %}
{% endblock proxies %}
