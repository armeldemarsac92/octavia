+static void http_policy_queue_final(struct stream *s)
+{
+	if (s->txn->policy && !s->txn->final_queued) {
+		s->txn->pending_informational = co_data(&s->res);
+		s->txn->final_queued = 1;
+	}
+}
+
+/* Called with a work buffer available and before forwarding any more data. */
+void http_policy_expire(struct stream *s)
+{
+	struct http_txn *txn = s->txn;
+	uint64_t now = http_policy_now_ms();
+
+	if ((!txn->request_expires_ms || txn->request_expires_ms > now) &&
+	    !txn->final_queued && (txn->flags & TX_L7_RETRY) &&
+	    (http_retry_on(s) & PR_RE_TIMEOUT) &&
+	    do_l7_retry(s, s->scb) == 0)
+		return;
+
+	txn->request_expires_ms = 0;
+	txn->attempt_expires_ms = 0;
+	pendconn_free(s);
+	s->scb->flags |= SC_FL_NOLINGER;
+	sc_shutdown(s->scb);
+	if (sc_state_in(s->scb->state, SC_SB_REQ|SC_SB_ASS))
+		s->scb->state = SC_ST_DIS;
+
+	if (!(s->flags & SF_ERR_MASK))
+		s->flags |= SF_ERR_SRVTO;
+	http_set_term_flags(s);
+	stream_inc_http_fail_ctr(s);
+
+	if (txn->final_started) {
+		/* A final status has reached the client mux. Abort without another reply. */
+		http_reply_and_close(s, txn->status, NULL);
+		channel_htx_erase(&s->res, htxbuf(&s->res.buf));
+		s->scf->flags |= SC_FL_NOLINGER;
+		sc_shutdown(s->scf);
+		return;
+	}
+
+	if (txn->final_queued)
+		co_set_data(&s->res, txn->pending_informational);
+	txn->status = 504;
+	txn->http_reply = NULL;
+	http_reply_and_close(s, txn->status, http_error_message(s));
+}
