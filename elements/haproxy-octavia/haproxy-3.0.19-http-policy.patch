+static enum act_return http_req_octavia_policy(struct act_rule *rule, struct proxy *px,
+                                             struct session *sess, struct stream *s, int flags)
+{
+	const struct http_request_policy *policy = rule->arg.http_policy;
+
+	if (!s->txn->policy) {
+		s->txn->policy = policy;
+		if (policy->request_timeout_ms && policy->request_timeout_ms != UINT64_MAX)
+			s->txn->request_expires_ms = http_policy_now_ms() + policy->request_timeout_ms;
+	}
+	return ACT_RET_CONT;
+}
+
+static void release_http_req_octavia_policy(struct act_rule *rule)
+{
+	free(rule->arg.http_policy);
+}
+
+/* Read a nonnegative decimal literal or the explicit default marker. */
+static int parse_http_policy_number(const char *arg, uint64_t max, uint64_t *number)
+{
+	if (strcmp(arg, "default") == 0) {
+		*number = UINT64_MAX;
+		return 1;
+	}
+	if (!*arg || arg[strspn(arg, "0123456789")])
+		return 0;
+	errno = 0;
+	*number = strtoull(arg, NULL, 10);
+	return !errno && *number <= max;
+}
+
+static enum act_parse_ret parse_http_req_octavia_policy(const char **args, int *orig_arg,
+                                                       struct proxy *px, struct act_rule *rule, char **err)
+{
+	struct http_request_policy policy, *compiled;
+	int cur = *orig_arg;
+	uint64_t retries;
+	const char *codes;
+
+	if (!*args[cur] || !*args[cur + 1] || !*args[cur + 2] || !*args[cur + 3] ||
+	    !parse_http_policy_number(args[cur], INT64_MAX, &policy.request_timeout_ms) ||
+	    !parse_http_policy_number(args[cur + 1], INT64_MAX, &policy.backend_timeout_ms) ||
+	    !parse_http_policy_number(args[cur + 2], INT_MAX, &retries)) {
+		memprintf(err, "expects request milliseconds, backend milliseconds, retry count and status codes");
+		return ACT_RET_PRS_ERR;
+	}
+	if (policy.request_timeout_ms && policy.request_timeout_ms != UINT64_MAX &&
+	    policy.backend_timeout_ms != UINT64_MAX &&
+	    policy.backend_timeout_ms > policy.request_timeout_ms) {
+		memprintf(err, "backend timeout exceeds request timeout");
+		return ACT_RET_PRS_ERR;
+	}
+
+	policy.retries = retries == UINT64_MAX ? -1 : (int)retries;
+	policy.retry_on = policy.retries > 0 ? PR_RE_CONN_FAILED | PR_RE_TIMEOUT : 0;
+	codes = args[cur + 3];
+	if (strcmp(codes, "none") != 0) {
+		if (policy.retries < 0)
+			goto bad_codes;
+		for (;;) {
+			size_t len = strcspn(codes, ",");
+			unsigned int bit;
+
+			if (len != 3 || codes[0] != '5' || codes[1] != '0')
+				goto bad_codes;
+			switch (codes[2]) {
+			case '0': bit = PR_RE_500; break;
+			case '2': bit = PR_RE_502; break;
+			case '3': bit = PR_RE_503; break;
+			case '4': bit = PR_RE_504; break;
+			default: goto bad_codes;
+			}
+			if (policy.retry_on & bit)
+				goto bad_codes;
+			policy.retry_on |= bit;
+			if (!codes[len])
+				break;
+			codes += len + 1;
+		}
+	}
+	if (policy.retries == 0)
+		policy.retry_on = 0;
+
+	compiled = malloc(sizeof(*compiled));
+	if (!compiled) {
+		memprintf(err, "out of memory");
+		return ACT_RET_PRS_ERR;
+	}
+	*compiled = policy;
+	rule->arg.http_policy = compiled;
+	rule->action = ACT_CUSTOM;
+	rule->action_ptr = http_req_octavia_policy;
+	rule->release_ptr = release_http_req_octavia_policy;
+	*orig_arg = cur + 4;
+	return ACT_RET_PRS_OK;
+
+  bad_codes:
+	memprintf(err, "expects 'none' or a comma-separated list of distinct 500,502,503,504 codes with an explicit retry count");
+	return ACT_RET_PRS_ERR;
+}
