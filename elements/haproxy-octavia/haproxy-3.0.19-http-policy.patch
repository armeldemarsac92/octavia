+int http_policy_expiration(const struct http_txn *txn)
+{
+	uint64_t deadline, now;
+
+	if (!txn || !txn->policy)
+		return TICK_ETERNITY;
+
+	deadline = txn->request_expires_ms;
+	if (txn->attempt_expires_ms && (!deadline || txn->attempt_expires_ms < deadline))
+		deadline = txn->attempt_expires_ms;
+	if (!deadline)
+		return TICK_ETERNITY;
+
+	now = http_policy_now_ms();
+	/* Keep every wakeup well within the signed scheduler tick horizon. */
+	return tick_add(now_ms, deadline <= now ? 1 : MIN(deadline - now, 1U << 29));
+}
