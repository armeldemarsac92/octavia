+
+static int verify_san_alpha(unsigned char c)
+{
+	return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z');
+}
+
+/* Return whether <name> contains only complete DNS labels. */
+static int verify_san_dns(const char *name, size_t len)
+{
+	unsigned int label_len = 0;
+	size_t i;
+
+	for (i = 0; i < len; i++) {
+		unsigned char c = name[i];
+
+		if (c == '.') {
+			if (!label_len || name[i - 1] == '-')
+				return 0;
+			label_len = 0;
+			continue;
+		}
+		if (!(verify_san_alpha(c) || (c >= '0' && c <= '9') || (c == '-' && label_len)))
+			return 0;
+		if (++label_len > 63)
+			return 0;
+	}
+	return label_len && name[len - 1] != '-';
+}
+
+/* Validate RFC 3986 component characters and percent encoding. */
+static int verify_san_uri_chars(const char *p, const char *end, const char *extra)
+{
+	for (; p < end; p++) {
+		unsigned char c = *p;
+
+		if (c == '%') {
+			if (end - p < 3 || hex2i(p[1]) < 0 || hex2i(p[2]) < 0)
+				return 0;
+			p += 2;
+		}
+		else if (!(verify_san_alpha(c) || (c >= '0' && c <= '9') ||
+		           strchr("-._~!$&'()*+,;=", c) || strchr(extra, c)))
+			return 0;
+	}
+	return 1;
+}
+
+static int verify_san_uri_authority(const char *host, const char *end)
+{
+	const char *userinfo = memchr(host, '@', end - host);
+	const char *port, *host_end;
+
+	if (userinfo) {
+		if (!verify_san_uri_chars(host, userinfo, ":"))
+			return 0;
+		host = userinfo + 1;
+	}
+	if (host == end)
+		return 0;
+
+	if (*host == '[') {
+		char address[INET6_ADDRSTRLEN];
+		struct in6_addr ipv6;
+		size_t len;
+
+		host++;
+		host_end = memchr(host, ']', end - host);
+		if (!host_end || (len = host_end - host) >= sizeof(address))
+			return 0;
+		memcpy(address, host, len);
+		address[len] = '\0';
+		if (inet_pton(AF_INET6, address, &ipv6) != 1)
+			return 0;
+		port = host_end + 1;
+	}
+	else {
+		port = memchr(host, ':', end - host);
+		if (!port)
+			port = end;
+		host_end = port;
+		if (host_end > host && host_end[-1] == '.')
+			host_end--;
+		if (!verify_san_dns(host, host_end - host))
+			return 0;
+	}
+
+	if (port == end)
+		return 1;
+	if (*port++ != ':')
+		return 0;
+	for (; port < end; port++) {
+		if (*port < '0' || *port > '9')
+			return 0;
+	}
+	return 1;
+}
+
+static int verify_san_uri(const char *uri)
+{
+	const char *p = uri;
+	const char *end;
+
+	if (!verify_san_alpha(*p++))
+		return 0;
+	p += strspn(p, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+.-");
+	if (*p != ':' || !p[1])
+		return 0;
+	p++;
+
+	if (p[0] == '/' && p[1] == '/') {
+		p += 2;
+		end = p + strcspn(p, "/?#");
+		if (!verify_san_uri_authority(p, end))
+			return 0;
+		p = end;
+	}
+
+	end = p + strcspn(p, "?#");
+	if (!verify_san_uri_chars(p, end, ":@/"))
+		return 0;
+	if (*end == '?') {
+		p = end + 1;
+		end = p + strcspn(p, "#");
+		if (!verify_san_uri_chars(p, end, ":@/?"))
+			return 0;
+	}
+	if (*end == '#') {
+		p = end + 1;
+		return verify_san_uri_chars(p, p + strlen(p), ":@/?");
+	}
+	return 1;
+}
