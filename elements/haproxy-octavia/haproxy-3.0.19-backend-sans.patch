+/* Apply the explicit SAN policy only after OpenSSL has verified the chain. */
+static int ssl_sock_srv_verify_san(int ok, X509_STORE_CTX *ctx)
+{
+	STACK_OF(GENERAL_NAME) *names;
+	const struct srv_verify_sans *sans;
+	struct connection *conn;
+	X509 *cert;
+	SSL *ssl;
+	int j;
+
+	if (!ok || X509_STORE_CTX_get_error_depth(ctx) != 0)
+		return ok;
+
+	ssl = X509_STORE_CTX_get_ex_data(ctx, SSL_get_ex_data_X509_STORE_CTX_idx());
+	conn = SSL_get_ex_data(ssl, ssl_app_data_index);
+	sans = __objt_server(conn->target)->ssl_ctx.verify_sans;
+	cert = X509_STORE_CTX_get_current_cert(ctx);
+
+	for (unsigned int i = 0; i < sans->count; i++) {
+		const struct srv_verify_san *san = &sans->entries[i];
+		unsigned int flags = X509_CHECK_FLAG_NEVER_CHECK_SUBJECT | X509_CHECK_FLAG_NO_PARTIAL_WILDCARDS;
+
+		if (san->type != GEN_DNS)
+			continue;
+		if (san->value[0] == '*')
+			flags |= X509_CHECK_FLAG_NO_WILDCARDS;
+		if (X509_check_host(cert, san->value, san->len, flags, NULL) == 1)
+			return 1;
+	}
+
+	names = X509_get_ext_d2i(cert, NID_subject_alt_name, NULL, NULL);
+	for (j = 0; j < sk_GENERAL_NAME_num(names); j++) {
+		const GENERAL_NAME *name = sk_GENERAL_NAME_value(names, j);
+		const ASN1_IA5STRING *uri;
+
+		if (name->type != GEN_URI)
+			continue;
+		uri = name->d.uniformResourceIdentifier;
+		for (unsigned int i = 0; i < sans->count; i++) {
+			const struct srv_verify_san *san = &sans->entries[i];
+
+			if (san->type == GEN_URI && ASN1_STRING_length(uri) == san->len &&
+			    memcmp(ASN1_STRING_get0_data(uri), san->value, san->len) == 0) {
+				GENERAL_NAMES_free(names);
+				return 1;
+			}
+		}
+	}
+	GENERAL_NAMES_free(names);
+	X509_STORE_CTX_set_error(ctx, X509_V_ERR_APPLICATION_VERIFICATION);
+	return 0;
+}
