+/* Parse a typed identity from a single token. Hex preserves URI characters
+ * that would otherwise be interpreted by the HAProxy configuration lexer.
+ */
+static int srv_parse_verify_san(char **args, int *cur_arg, struct proxy *px, struct server *srv, char **err)
+{
+	const char *arg = args[*cur_arg + 1];
+	struct srv_verify_sans *sans = srv->ssl_ctx.verify_sans;
+	struct srv_verify_san san = { 0 };
+	size_t i;
+
+	if (strcmp(args[0], "server") != 0) {
+		memprintf(err, "'verify-san' is only supported on static server lines");
+		return ERR_ALERT | ERR_FATAL;
+	}
+	if (sans && sans->count == SRV_VERIFY_SAN_MAX) {
+		memprintf(err, "'verify-san' accepts at most %d entries", SRV_VERIFY_SAN_MAX);
+		return ERR_ALERT | ERR_FATAL;
+	}
+
+	if (strncmp(arg, "dns:", 4) == 0) {
+		const char *name = arg + 4;
+		size_t wildcard_len = strncmp(name, "*.", 2) == 0 ? 2 : 0;
+		struct in_addr ipv4;
+
+		san.type = GEN_DNS;
+		san.len = strlen(name);
+		if (san.len <= wildcard_len || san.len > SRV_VERIFY_SAN_LEN ||
+		    !verify_san_dns(name + wildcard_len, san.len - wildcard_len) ||
+		    inet_pton(AF_INET, name + wildcard_len, &ipv4) == 1)
+			goto invalid;
+		memcpy(san.value, name, san.len);
+	}
+	else if (strncmp(arg, "uri-hex:", 8) == 0) {
+		const char *hex = arg + 8;
+		size_t len = strlen(hex);
+
+		san.type = GEN_URI;
+		if (!len || len % 2 || len / 2 > SRV_VERIFY_SAN_LEN)
+			goto invalid;
+		san.len = len / 2;
+		for (i = 0; i < san.len; i++) {
+			int hi = hex2i(hex[i * 2]);
+			int lo = hex2i(hex[i * 2 + 1]);
+
+			if (hi < 0 || lo < 0 || (hi == 0 && lo == 0))
+				goto invalid;
+			san.value[i] = hi * 16 + lo;
+		}
+		if (!verify_san_uri(san.value))
+			goto invalid;
+	}
+	else
+		goto invalid;
+
+	if (!sans) {
+		sans = calloc(1, sizeof(*sans));
+		if (!sans) {
+			memprintf(err, "'verify-san' : not enough memory");
+			return ERR_ALERT | ERR_FATAL;
+		}
+		srv->ssl_ctx.verify_sans = sans;
+	}
+	sans->entries[sans->count++] = san;
+	return 0;
+
+ invalid:
+	memprintf(err, "'verify-san' expects a DNS name in dns:<name> or an absolute URI in uri-hex:<hex>");
+	return ERR_ALERT | ERR_FATAL;
 }
 
