+/* Keep cumulative counts in ordered, fixed-size blocks. A lookup can
+ * recover an exact millisecond boundary with one tree search. Incrementing
+ * a counter never reallocates or copies older blocks.
+ */
+#define RETRY_BUDGET_BLOCK_MS 64
+#define RETRY_BUDGET_PRUNE_BATCH 8
+
+struct retry_budget_block {
+	struct eb64_node node;
+	uint64_t before;
+	unsigned int length;
+	uint64_t cumulative[RETRY_BUDGET_BLOCK_MS];
+};
+
+struct retry_budget_history {
+	struct eb_root blocks;
+	uint64_t total;
+	unsigned int retention_ms;
+};
+
+struct retry_budget_service {
+	struct list entries;
+	char uid[129];
+	unsigned int refs;
+	__decl_thread(HA_SPINLOCK_T lock);
+	struct task *expiry;
+	struct retry_budget_history originals, retries;
+};
+
+struct octavia_retry_budget {
+	struct retry_budget_service *service;
+	unsigned int percent, interval_ms;
+	unsigned int min_count, min_interval_ms;
+};
+
+static struct list retry_budget_services = LIST_HEAD_INIT(retry_budget_services);
+
+static inline struct retry_budget_block *retry_budget_block(struct eb64_node *node)
+{
+	return eb64_entry(node, struct retry_budget_block, node);
+}
+
+static uint64_t retry_budget_count(struct retry_budget_history *history,
+                                    uint64_t now, unsigned int interval_ms)
+{
+	struct retry_budget_block *block;
+	uint64_t cutoff, slot;
+	unsigned int offset;
+
+	if (now < interval_ms)
+		return history->total;
+
+	cutoff = now - interval_ms;
+	slot = cutoff / RETRY_BUDGET_BLOCK_MS;
+	block = retry_budget_block(eb64_lookup_ge(&history->blocks, slot));
+	if (!block)
+		return 0;
+	if (block->node.key != slot)
+		return history->total - block->before;
+
+	offset = MIN(cutoff % RETRY_BUDGET_BLOCK_MS, block->length - 1);
+	return history->total - block->cumulative[offset];
+}
+
+static int retry_budget_record(struct retry_budget_service *service,
+                               struct retry_budget_history *history, uint64_t now)
+{
+	struct eb64_node *last;
+	struct retry_budget_block *block;
+	uint64_t slot = now / RETRY_BUDGET_BLOCK_MS;
+	unsigned int offset = now % RETRY_BUDGET_BLOCK_MS;
+
+	if (!history->retention_ms)
+		return 1;
+	last = eb64_last(&history->blocks);
+	block = retry_budget_block(last);
+	if (!block || block->node.key != slot) {
+		block = malloc(sizeof(*block));
+		if (!block)
+			return 0;
+		*block = (struct retry_budget_block){
+			.node.key = slot,
+			.before = history->total,
+		};
+		eb64_insert(&history->blocks, &block->node);
+		if (!last)
+			task_wakeup(service->expiry, TASK_WOKEN_MSG);
+	}
+
+	while (block->length <= offset)
+		block->cumulative[block->length++] = history->total;
+	block->cumulative[offset] = ++history->total;
+	return 1;
+}
+
+static int retry_budget_prune(struct retry_budget_history *history, uint64_t now,
+                              struct retry_budget_block **expired,
+                              unsigned int *count)
+{
+	unsigned int i = 0;
+	struct eb64_node *node;
+	uint64_t expires;
+
+	while ((node = eb64_first(&history->blocks))) {
+		/* The end of the block is fixed even when later requests
+		 * arrive in the same block while the timer is queued.
+		 */
+		expires = (node->key + 1) * RETRY_BUDGET_BLOCK_MS - 1 + history->retention_ms;
+		if (expires > now)
+			return tick_add(now_ms, expires - now);
+		if (i++ == RETRY_BUDGET_PRUNE_BATCH)
+			return tick_add(now_ms, 1);
+		eb64_delete(node);
+		expired[(*count)++] = retry_budget_block(node);
+	}
+	return TICK_ETERNITY;
+}
+
+static struct task *retry_budget_expire(struct task *task, void *context, unsigned int state)
+{
+	struct retry_budget_service *service = context;
+	struct retry_budget_block *expired[2 * RETRY_BUDGET_PRUNE_BATCH];
+	unsigned int count = 0;
+	uint64_t now;
+	int originals, retries;
+
+	HA_SPIN_LOCK(OTHER_LOCK, &service->lock);
+	now = HA_ATOMIC_LOAD(&global_now_ns) / 1000000;
+	originals = retry_budget_prune(&service->originals, now, expired, &count);
+	retries = retry_budget_prune(&service->retries, now, expired, &count);
+	task->expire = tick_first(originals, retries);
+	HA_SPIN_UNLOCK(OTHER_LOCK, &service->lock);
+
+	while (count)
+		free(expired[--count]);
+	return task;
+}
+
+static void retry_budget_clear(struct retry_budget_history *history)
+{
+	struct eb64_node *node;
+
+	while ((node = eb64_first(&history->blocks))) {
+		eb64_delete(node);
+		free(retry_budget_block(node));
+	}
+}
+
+void octavia_retry_budget_original(struct stream *s)
+{
+	const struct octavia_retry_budget *policy = s->txn ? s->txn->retry_budget : NULL;
+	struct retry_budget_service *service;
+
+	if (!policy || !policy->service->originals.retention_ms)
+		return;
+	service = policy->service;
+	HA_SPIN_LOCK(OTHER_LOCK, &service->lock);
+	/* If an allocation fails, omitting an original reduces the percentage allowance. */
+	retry_budget_record(service, &service->originals, HA_ATOMIC_LOAD(&global_now_ns) / 1000000);
+	HA_SPIN_UNLOCK(OTHER_LOCK, &service->lock);
+}
+
+int octavia_retry_budget_admit(const struct stream *s)
+{
+	const struct octavia_retry_budget *policy = s->txn ? s->txn->retry_budget : NULL;
+	struct retry_budget_service *service;
+	uint64_t now;
+	int allowed;
+
+	if (!policy || !policy->service->retries.retention_ms)
+		return 1;
+	service = policy->service;
+	HA_SPIN_LOCK(OTHER_LOCK, &service->lock);
+	now = HA_ATOMIC_LOAD(&global_now_ns) / 1000000;
+	allowed = policy->percent == 100 ||
+	          retry_budget_count(&service->retries, now, policy->min_interval_ms) < policy->min_count;
+	if (!allowed && policy->percent) {
+		uint64_t originals = retry_budget_count(&service->originals, now, policy->interval_ms);
+		uint64_t retries = retry_budget_count(&service->retries, now, policy->interval_ms);
+
+		/* Include the candidate in both the numerator and denominator. */
+		allowed = (retries + 1) * (100 - policy->percent) <= originals * policy->percent;
+	}
+	allowed = allowed && retry_budget_record(service, &service->retries, now);
+	HA_SPIN_UNLOCK(OTHER_LOCK, &service->lock);
+	return allowed;
+}
+
+static struct retry_budget_service *retry_budget_get_service(const char *uid)
+{
+	struct retry_budget_service *service;
+
+	list_for_each_entry(service, &retry_budget_services, entries) {
+		if (!strcmp(service->uid, uid))
+			return service;
+	}
+	service = calloc(1, sizeof(*service));
+	if (!service)
+		return NULL;
+
+	service->expiry = task_new_anywhere();
+	if (!service->expiry) {
+		free(service);
+		return NULL;
+	}
+	service->expiry->process = retry_budget_expire;
+	service->expiry->context = service;
+	service->originals.blocks = EB_ROOT_UNIQUE;
+	service->retries.blocks = EB_ROOT_UNIQUE;
+	strlcpy2(service->uid, uid, sizeof(service->uid));
+	HA_SPIN_INIT(&service->lock);
+	LIST_APPEND(&retry_budget_services, &service->entries);
+	return service;
+}
+
+static void release_http_req_octavia_budget(struct act_rule *rule)
+{
+	struct retry_budget_service *service = rule->arg.retry_budget->service;
+
+	if (--service->refs == 0) {
+		LIST_DELETE(&service->entries);
+		task_destroy(service->expiry);
+		retry_budget_clear(&service->originals);
+		retry_budget_clear(&service->retries);
+		free(service);
+	}
+	free(rule->arg.retry_budget);
+}
+
+static enum act_return http_req_octavia_budget(struct act_rule *rule, struct proxy *px,
+                                               struct session *sess, struct stream *s, int flags)
+{
+	s->txn->retry_budget = rule->arg.retry_budget;
+	return ACT_RET_CONT;
+}
+
+static enum act_parse_ret parse_http_req_octavia_budget(const char **args, int *orig_arg,
+                                                        struct proxy *px, struct act_rule *rule, char **err)
+{
+	struct octavia_retry_budget *policy;
+	struct retry_budget_service *service;
+	int cur = *orig_arg;
+	const char *uid = args[cur];
+	uint64_t percent, interval, min_count, min_interval;
+
+	if (!(px->cap & PR_CAP_BE) || !*uid || strlen(uid) > 128 ||
+	    uid[strspn(uid, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-")] ||
+	    !*args[cur + 1] || !*args[cur + 2] || !*args[cur + 3] || !*args[cur + 4] ||
+	    !parse_http_policy_number(args[cur + 1], 100, &percent) || percent > 100 ||
+	    !parse_http_policy_number(args[cur + 2], 3600000, &interval) || interval < 1000 || interval > 3600000 ||
+	    !parse_http_policy_number(args[cur + 3], 1000000, &min_count) || min_count < 1 || min_count > 1000000 ||
+	    !parse_http_policy_number(args[cur + 4], 3600000, &min_interval) || min_interval < 1 || min_interval > 3600000) {
+		memprintf(err, "expects a backend Service UID, percentage, budget interval in ms, minimum retries and minimum interval in ms");
+		return ACT_RET_PRS_ERR;
+	}
+	policy = malloc(sizeof(*policy));
+	service = policy ? retry_budget_get_service(uid) : NULL;
+	if (!service) {
+		free(policy);
+		memprintf(err, "out of memory");
+		return ACT_RET_PRS_ERR;
+	}
+	*policy = (struct octavia_retry_budget){ service, percent, interval, min_count, min_interval };
+	service->refs++;
+	if (percent < 100) {
+		service->retries.retention_ms = MAX(service->retries.retention_ms, min_interval);
+		if (percent) {
+			service->originals.retention_ms = MAX(service->originals.retention_ms, interval);
+			service->retries.retention_ms = MAX(service->retries.retention_ms, interval);
+		}
+	}
+	rule->arg.retry_budget = policy;
+	rule->action = ACT_CUSTOM;
+	rule->action_ptr = http_req_octavia_budget;
+	rule->release_ptr = release_http_req_octavia_budget;
+	*orig_arg = cur + 5;
+	return ACT_RET_PRS_OK;
+}
