+
+	for (blk = htx_get_head_blk(htx); blk;) {
+		if (htx_get_blk_type(blk) == HTX_BLK_TLR) {
+			struct htx *headers = body->replay ? htxbuf(&body->saved) : htx;
+			struct htx_sl *sl = http_get_stline(headers);
