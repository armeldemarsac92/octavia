+/* The request channel remains a standard HTX buffer. While a rule awaits a
+ * complete message, park its headers and drain DATA as the mux delivers it.
+ * The second HTX buffer holds headers during collection and trailers during
+ * replay. Body storage grows with received bytes, at most the rule's limit.
+ */
+/* Retain only a bounded number of bodies, including slow origin replays. */
+#define HTTP_BUFFERED_BODY_LIMIT 256
+static unsigned int http_buffered_bodies;
+static unsigned long long http_body_bytes;
+static unsigned long long http_body_max_memory = 64ULL * 1024 * 1024;
+
+static int cfg_parse_body_memory(char **args, int section_type, struct proxy *px,
+                                 const struct proxy *defpx, const char *file, int line, char **err)
+{
+	long long value;
+
+	if (!*args[1] || *args[2] || args[1][strspn(args[1], "0123456789")] ||
+	    strl2llrc(args[1], strlen(args[1]), &value) || value < 1) {
+		memprintf(err, "'%s' expects a positive decimal byte count", args[0]);
+		return -1;
+	}
+	http_body_max_memory = value;
+	return 0;
+}
+
+static struct cfg_kw_list body_memory_keywords = { ILH, {
+	{ CFG_GLOBAL, "tune.octavia-auth-body-max-memory", cfg_parse_body_memory },
+	{ 0, NULL, NULL },
+} };
+
+INITCALL1(STG_REGISTER, cfg_register_keywords, &body_memory_keywords);
+
+struct http_buffered_body {
+	struct buffer saved;
+	struct ist bytes;
+	size_t capacity;
+	size_t replayed;
+	int complete;
+	int replay;
+};
+
+static void http_free_buffered_body(struct http_txn *txn)
+{
+	struct http_buffered_body *body = txn->buffered_body;
+
+	if (!body)
+		return;
+	if (b_size(&body->saved)) {
+		b_free(&body->saved);
+		offer_buffers(NULL, 1);
+	}
+	free(body->bytes.ptr);
+	_HA_ATOMIC_SUB(&http_body_bytes, body->capacity);
+	free(body);
+	txn->buffered_body = NULL;
+	_HA_ATOMIC_DEC(&http_buffered_bodies);
+}
+
+static int http_store_body_bytes(struct http_buffered_body *body, struct ist data, unsigned int limit)
+{
+	size_t needed, capacity;
+	unsigned long long used;
+	size_t growth;
+	char *ptr;
+
+	if (data.len > limit - body->bytes.len)
+		return 413;
+	needed = body->bytes.len + data.len;
+	if (needed > body->capacity) {
+		capacity = MAX(needed, MIN((size_t)limit, body->capacity * 2));
+		/* Charge the actual allocation, including spare capacity. Under
+		 * pressure prefer the bytes needed now over speculative growth.
+		 */
+		used = _HA_ATOMIC_LOAD(&http_body_bytes);
+		do {
+			if (needed - body->capacity > http_body_max_memory - used)
+				return 503;
+			growth = capacity - body->capacity;
+			if (growth > http_body_max_memory - used)
+				growth = needed - body->capacity;
+		} while (!_HA_ATOMIC_CAS(&http_body_bytes, &used, used + growth));
+		capacity = body->capacity + growth;
+		ptr = realloc(body->bytes.ptr, capacity);
+		if (!ptr) {
+			_HA_ATOMIC_SUB(&http_body_bytes, growth);
+			return 503;
+		}
+		body->capacity = capacity;
+		body->bytes.ptr = ptr;
+	}
+	if (data.len)
+		memcpy(body->bytes.ptr + body->bytes.len, data.ptr, data.len);
+	body->bytes.len = needed;
+	return 200;
+}
+
+/* Return 0 while awaiting the mux, 200 with the complete binary payload, or
+ * an HTTP failure status. A later auth rule may check the same transaction
+ * against a different limit without reading the transport a second time.
+ */
+int http_collect_request_body(struct stream *s, unsigned int limit, struct ist *payload)
+{
+	struct http_buffered_body *body = s->txn->buffered_body;
+	struct buffer *input = &s->req.buf;
+	struct htx *htx = htxbuf(input);
