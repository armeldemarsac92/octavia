+		struct http_hdr_ctx ctx = { .blk = NULL };
+		unsigned long long declared = 0;
+
+		if (http_find_header(htx, ist("content-length"), &ctx, 0)) {
+			if (http_parse_cont_len_header(&ctx.value, &declared, 0) < 0)
+				return 400;
+			if (declared > limit)
+				return 413;
+		}
+		if (http_handle_expect_hdr(s, htx, &s->txn->req) < 0)
+			return 503;
+		if (_HA_ATOMIC_ADD_FETCH(&http_buffered_bodies, 1) > HTTP_BUFFERED_BODY_LIMIT) {
+			_HA_ATOMIC_DEC(&http_buffered_bodies);
+			return 503;
+		}
+		body = calloc(1, sizeof(*body));
+		if (!body) {
+			_HA_ATOMIC_DEC(&http_buffered_bodies);
+			return 503;
+		}
+		s->txn->buffered_body = body;
+		if (!eom) {
+			struct htx *headers;
+
+			if (!b_alloc(&body->saved, DB_CHANNEL))
+				return 503;
+			headers = htx_from_buf(&body->saved);
+			htx_xfer_blks(headers, htx, UINT_MAX, HTX_BLK_EOH);
+			if (htx_get_tail_type(headers) != HTX_BLK_EOH)
+				return 503;
+			body->replay = 1;
