+/* Header admission is independent of how existing blocks are decoded. */
+static inline int htx_header_fits(const struct ist name, const struct ist value)
+{
+	return (value.len <= 1048575 &&
+	        (name.len <= 255 || (name.len == 256 &&
+	         (global.tune.options & GTUNE_OCTAVIA_HDR_NAME_256))));
+}
+
+/* Encodes header lengths after htx_header_fits() has checked them. */
+static inline uint32_t htx_header_info(uint32_t name_len, uint32_t value_len)
+{
+	uint32_t type = (name_len == 256 ? HTX_BLK_HDR_256 : HTX_BLK_HDR);
+
+	return (type << 28) | (value_len << 8) | (name_len & 0xff);
+}
