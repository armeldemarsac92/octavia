+/* Returns the logical block type from its encoded metadata. */
+static inline enum htx_blk_type htx_decode_blk_type(uint32_t info)
+{
+	enum htx_blk_type type = info >> 28;
+
+	return (type == HTX_BLK_HDR_256 ? HTX_BLK_HDR : type);
+}
+
 /* Returns the type of the block <blk> */
 static inline enum htx_blk_type htx_get_blk_type(const struct htx_blk *blk)
 {
-	return (blk->info >> 28);
+	return htx_decode_blk_type(blk->info);
+}
+
+/* Returns the name length of a header or trailer block. */
+static inline uint32_t htx_get_blk_name_len(const struct htx_blk *blk)
+{
+	return ((blk->info >> 28) == HTX_BLK_HDR_256 ? 256 : blk->info & 0xff);
 }

