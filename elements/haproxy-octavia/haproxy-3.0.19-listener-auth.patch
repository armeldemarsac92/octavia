+/* A headers-only caller makes a decision at EOH. Never queue a payload. */
+static int httpclient_capture_headers(struct httpclient *hc, struct htx *htx)
+{
+	struct htx_blk *blk;
+	unsigned int count = 0, i = 0;
+
+	for (blk = htx_get_head_blk(htx); blk; blk = htx_get_next_blk(htx, blk)) {
+		if (htx_get_blk_type(blk) == HTX_BLK_EOH)
+			break;
+		if (htx_get_blk_type(blk) != HTX_BLK_HDR || ++count > global.tune.max_http_hdr)
