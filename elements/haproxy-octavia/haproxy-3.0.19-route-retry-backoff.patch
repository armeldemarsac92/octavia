+/* The previous endpoint has been detached. Preserve the target for
+ * redispatch and affinity, but make its slot available to other requests.
+ */
+void http_policy_schedule_retry(struct stream *s, enum http_retry_pending reason)
+{
+	struct http_txn *txn = s->txn;
+	struct connection *conn = sc_conn(s->scf);
+	struct server *target = objt_server(s->target);
+	struct server *slot = s->srv_conn;
+
+	if (target != txn->retry_server) {
+		if (target)
+			srv_take(target);
+		srv_drop(txn->retry_server);
+		txn->retry_server = target;
+	}
+	if (slot) {
+		sess_change_server(s, NULL);
+		if (may_dequeue_tasks(slot, s->be))
+			process_srv_queue(slot);
+	}
+
+	/* Ask the client mux to report an abort while no backend is attached. */
+	if (conn && conn->mux && conn->mux->ctl)
+		conn->mux->ctl(conn, MUX_CTL_SUBS_RECV, NULL);
+
+	txn->attempt_expires_ms = 0;
+	txn->retry_after_ms = http_policy_now_ms() + txn->policy->retry_backoff_ms;
+	txn->retry_pending = reason;
+	s->conn_exp = http_policy_deadline_tick(txn->retry_after_ms);
+	s->scb->state = SC_ST_TAR;
+}
